{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_package_input.schema.json",
  "title": "ChatGPT Review Package \u2014 Input",
  "description": "The bounded package a human exports to ChatGPT. No AI API is called by this repository; the package is generated, handed to a human, and the returned assessment is imported and validated separately. The package must never contain secrets, private company information, unbounded article text, or raw licensed content that cannot be shared.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "methodology_version",
    "generated_at",
    "data_cutoff_at",
    "source_health_summary",
    "key_indicators",
    "lane_status",
    "active_operational_events",
    "external_drivers",
    "evidence_records",
    "conflicting_evidence",
    "previous_assessments",
    "data_gaps",
    "output_instructions",
    "required_output_binding",
    "exclusions_applied",
    "dataset",
    "package_purpose",
    "source_cutoff",
    "provenance_summary"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^PKG-[0-9]{8}-[0-9]{3,}$"
    },
    "methodology_version": {
      "const": "0.8"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_health_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_status",
        "coverage_message",
        "sources",
        "capabilities"
      ],
      "properties": {
        "overall_status": {
          "enum": [
            "sufficient",
            "limited",
            "insufficient"
          ]
        },
        "coverage_message": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "key_indicators": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lane_status": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "active_operational_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "external_drivers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Bounded evidence items. Each carries an evidence_id the returned assessment must reference; an assessment referencing an unknown evidence_id is rejected on import."
    },
    "conflicting_evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "previous_assessments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_sections",
        "prohibited_outputs",
        "output_schema_path",
        "required_output_binding_instructions"
      ],
      "properties": {
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "prohibited_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "output_schema_path": {
          "type": "string"
        },
        "required_output_binding_instructions": {
          "type": "string",
          "minLength": 1,
          "description": "WO-010-R3 §1: tells whoever pastes this package which five fields the returned output must echo verbatim (see required_output_binding below), and that produced_at is not one of them."
        }
      }
    },
    "exclusions_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "What was deliberately withheld from the package (secrets, private company information, unbounded article text, restricted raw content). Recorded so a reviewer can see the boundary was applied."
    },
    "package_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "required_output_binding": {
      "description": "WO-010-R3 §1: the same five values as literals, restated here (not only as instructions) so a script diffing an output against its package has one well-known location to read, and a human pasting the package can copy them directly.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_package_sha256",
        "input_dataset",
        "input_package_purpose",
        "input_data_cutoff_at",
        "input_source_cutoff"
      ],
      "properties": {
        "input_package_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_dataset": {
          "enum": [
            "current_publication",
            "technical_demo",
            "historical_validation"
          ]
        },
        "input_package_purpose": {
          "enum": [
            "current_intelligence_assessment",
            "engine_demonstration"
          ]
        },
        "input_data_cutoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_source_cutoff": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "dataset": {
      "description": "Which publication surface this package was built from. Only a current_publication package may be approved into the current AI Outlook.",
      "enum": [
        "current_publication",
        "technical_demo",
        "historical_validation"
      ]
    },
    "package_purpose": {
      "description": "What the package is for. Must agree with the dataset: a technical_demo package is an engine demonstration however it is labelled.",
      "enum": [
        "current_intelligence_assessment",
        "engine_demonstration"
      ]
    },
    "source_cutoff": {
      "description": "The instant the underlying source records were selected against. Recorded separately from data_cutoff_at so an approval can detect an assessment produced against a different vintage of the same package.",
      "type": "string",
      "format": "date-time"
    },
    "provenance_summary": {
      "description": "Where the package's contents came from, and how many records the qualification filter excluded. Lets a reviewer and the approval gate see the provenance mix without re-deriving it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "events",
        "excluded_fixture_record_count"
      ],
      "properties": {
        "evidence": {
          "type": "object"
        },
        "events": {
          "type": "object"
        },
        "excluded_fixture_record_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
